{
  "expo": {
    "name": "rewear-project",
    "slug": "rewear-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rewear-project",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*",
      "assets/data/*.csv"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rewear.project",
      "infoPlist": {
        "NSCameraUsageDescription": "케어라벨이나 옷 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "옷 사진을 앨범에서 선택하기 위해 사진첩 접근 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rewear.project"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "076a5cfb9cfe5f1341f96cdf7a259b8f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    }
  }
}