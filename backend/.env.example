# Copy to backend/.env, then fill in local values. Never commit backend/.env.
# Example shape: postgresql+psycopg2://DB_USER:URL_ENCODED_PASSWORD@localhost:5432/DB_NAME
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set a unique random secret of at least 32 characters.
SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
YOUTUBE_API_KEY=
EXTERNAL_BASE_URL=http://localhost:8000
FABRIC_CKPT=app/models/best_multitask.pt
